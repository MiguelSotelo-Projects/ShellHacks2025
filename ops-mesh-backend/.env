# Environment Configuration for Ops Mesh Backend
# Copy this file to .env and fill in your actual values

# Application Settings
DEBUG=True
PROJECT_NAME="Ops Mesh - Patient Check-In"
SECRET_KEY="ops-mesh-hackathon-secret-key-change-in-production"

# Database Configuration
DATABASE_URL="sqlite:///./ops_mesh.db"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="path/to/your/service-account-key.json"
GOOGLE_CLOUD_REGION="us-central1"

# Google ADK (Agent Development Kit) Configuration
ADK_AGENT_ENDPOINT="https://your-adk-endpoint.googleapis.com"
ADK_API_KEY="your-adk-api-key"

# CORS Settings (Frontend URLs)
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:3001","https://ops-mesh-frontend.vercel.app"]'

# Queue Management Settings
DEFAULT_WAIT_TIME_MINUTES=15
MAX_QUEUE_SIZE=100
QUEUE_UPDATE_INTERVAL_SECONDS=30

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

# Hospital Configuration
HOSPITAL_NAME="General Hospital"
HOSPITAL_ID="GH001"

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30